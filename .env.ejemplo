# Copie este archivo como .env en el servidor y complete los valores. Nunca lo comparta.

PUERTO=3000
ARCHIVO_DATOS=datos/estado.json

# 360dialog: clave de API del número (Hub → número → API Key)
D360_API_KEY=
# Texto largo al azar: forma parte de la dirección del webhook para que nadie más la use
WEBHOOK_SECRETO=

# Telegram: token del bot (de @BotFather) y el chat donde Verónica recibe los avisos
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Texto al azar: Telegram lo manda en cada aviso para comprobar que es él
TELEGRAM_SECRETO=
# Chat de Telegram del dueño: recibe su propia cola fijada y las alertas de seguimiento (varios separados por coma)
TELEGRAM_CHAT_SUPERVISOR=
# Avisar al dueño cuando un cliente lleve estos minutos esperando (contando solo en horario)
ALERTA_ESPERA_MIN=30

# Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
MODELO_IA=claude-haiku-5-5
MAX_USOS_IA=4

# Panel web (panel.editoraortega.com)
PANEL_USUARIO=veronica
PANEL_CLAVE=
